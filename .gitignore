# Dependencies
node_modules/
bun.lock

# 构建产物（web/ 的 antd 版面板）
web/dist/
web/*.tsbuildinfo
# export_web_data.py 的输出：真实简历 PDF、话术、评估内容——个人数据，绝不进版本库
web/public/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Compiled documents
*.pdf
*.aux
*.log
*.out
*.synctex.gz
*.fls
*.fdb_latexmk

# Personal data (never commit these)
# Personal profile data — the whole directory is private (created by /setup)
profile/
salary_data.json
# Match at any depth. The live path is `users/<active user>/job_scraper/…`
# (AGENTS.md "活动用户与多用户"), which a rooted `job_scraper/...` pattern would
# already miss. Keeping it depth-independent is also the cheap insurance:
# this rule was originally written because the scraper resolved `job_scraper/`
# relative to its own skill directory and the state landed under
# `.claude/skills/job-scrape/`. That stopped being true when the workflow bodies
# moved out of the skills and personal data moved under `users/`, but the reason
# stayed on the rule for a long time afterwards - and a stale reason on a privacy
# rule is worse than none: the next reader concludes the scraper is Claude-coupled
# and goes looking for state in a directory that holds one SKILL.md.
**/job_scraper/seen_jobs.json
**/job_scraper/notion_sync.json
**/job_scraper/*.md

# 多用户：每用户数据根与活动用户指针
users/
.active_user
# 根级激活文件兜底：.active_user 缺失/迁移未完成时，激活文件可能误落到仓库根
# 而非 users/<用户>/templates/ 下。这条规则让它进不了版本库，但也让 git status 对它
# 沉默——所以 tools/lint_skills.py 会直接报错指路，别只靠这一行。
templates/active-*.md

# Personal photos and signatures
*.jpg
*.jpeg
*.png

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Memory files (Claude Code user-specific)
.claude/projects/
# 本机授予的权限：Claude Code 把它合并到 settings.json 之上，提交它等于把本机的
# 预授权推给每一个 pull 的 fork（tools/security_guards.py 会同时检查它的内容）
.claude/settings.local.json

# Skills lock (auto-generated)
skills-lock.json

# Personal application output files (generated by /apply — do not share)
resume/main.typ
resume/*.pdf
cover_letter/main.typ
cover_letter/*.pdf

# Resume photo — lives in resume/ (same dir as main.typ), not profile/,
# because Typst image() cannot reach outside the entry-file directory.
# *.jpg/*.png below already catch it; this is an explicit belt-and-suspenders
# rule in case another image format is used.
resume/photo.*

# documents/ subfolder contents are personal — only README and folder structure are tracked
documents/cv/**
documents/linkedin/**
documents/diplomas/**
documents/references/**
documents/applications/**
documents/postings/**
# Interview prep and experience records: these name the employers applied to,
# quote what was submitted, and set out the candidate's weak points.
documents/interview/**
!documents/**/.gitkeep

# Personal job search tracking
job_search_tracker.csv

# Gmail sync state (message IDs, subjects - personal data)
gmail_sync/

# Generated reports (personal output from /html-report)
reports/

# Upskill reports (personal output)
# 整目录，不用扩展名通配 —— 同族的 gmail_sync/ 与 reports/ 都是整目录规则。
# 扩展名通配的脆处：哪天有人往这儿落一个 .json 缓存就会被静默提交，
# 而这里面是他的能力差距分析。同一类脆处 2026-08-20 在 web/public/ 上栽过一次。
upskill/

# Agent skills: track the source, ignore only deps and logs.
# (A blanket `.agents/` ignore silently drops the job-search CLI skills from the repo.)
.agents/**/node_modules/
.agents/**/*.log
.agents/usage/

# Brainstorm mockups (superpowers visual companion) - never ship
.superpowers/

# Superpowers dev-process artifacts (specs/plans) — contain maintainer notes, not product
docs/superpowers/

# 维护者的本机笔记：发布前清单、个人标识符词表等。**永远不进版本库。**
# 这里放的东西按设计就是「不该被别人看到、但本机需要」的那一类。
.private/

# Claude 那三个技能壳被工具**镜像**到 `.agents/skills/` 下的副本：不是仓库内容。
# 正本在 `.claude/skills/{job-application-assistant,job-scrape,job-upskill}/SKILL.md`，
# 这三份与它字节相同（2026-08-24 由所在的 AI 工具自动生成，不是谁手写的）。
# 收进版本库就是本仓库最反对的那件事：一条规则两个落点，之后各自长出对方没有的一条。
# `.agents/skills/` 本身仍然照常入库 —— 那儿放的是可插拔平台技能（liepin-search）。
.agents/skills/job-application-assistant/
.agents/skills/job-scrape/
.agents/skills/job-upskill/
.workbuddy/
promot*

